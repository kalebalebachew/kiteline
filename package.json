{
	"name": "kiteline",
	"version": "0.3.3",
	"description": "Drive Claude Code on your computer from your phone.",
	"license": "MIT",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"dev:server": "turbo run dev -F server --",
		"env:generate": "varlock codegen --path ./apps/web/",
		"postinstall": "varlock codegen --path ./apps/web/",
		"check": "biome check --write .",
		"start": "pnpm --filter server start",
		"pair": "pnpm --silent --filter server pair",
		"devices": "pnpm --silent --filter server devices --",
		"release": "node scripts/release.mjs",
		"deploy:relay": "./scripts/deploy-relay.sh",
		"deploy:relay-env": "./scripts/push-relay-env.sh"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@kiteline/config": "workspace:*",
		"@types/node": "^26.4.1",
		"turbo": "^2.11.7",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"packageManager": "pnpm@12.15.0",
	"engines": {
		"node": "^22.18.0 || >=24.11.0"
	}
}
