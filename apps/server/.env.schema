# Kiteline server settings. Every value has a default, so a .env file is optional.
# @defaultRequired=false
# @defaultSensitive=false
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=production

# Port the server (and, after a build, the web app) listens on.
# @type=port
PORT=4545

# Address to bind. 0.0.0.0 lets your phone reach it on the same network or tailnet.
HOST=0.0.0.0

# The address your phone uses when it isn't on the same network, such as the
# https://<machine>.<tailnet>.ts.net address from `tailscale serve`. The pairing
# link and QR code point here.
# @type=url
KITELINE_PUBLIC_URL=

# Fixed pairing token. Leave empty to have Kiteline generate one in ~/.kiteline/auth.json.
# @sensitive
KITELINE_TOKEN=

# Folder for Kiteline's own files (pairing token). Defaults to ~/.kiteline.
KITELINE_HOME=

# Path to a `claude` executable. Leave empty to use the one bundled with the Agent SDK.
CLAUDE_PATH=

# Allow switching a session to bypass-permissions mode from the web app.
# @type=boolean
KITELINE_ALLOW_BYPASS=true

# How many Claude Code processes may run at once.
# @type=number
KITELINE_MAX_SESSIONS=6

# Minutes an idle session keeps its process before it sleeps. The next message wakes it.
# @type=number
KITELINE_IDLE_MINUTES=20
