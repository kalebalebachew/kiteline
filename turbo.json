{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": ["dist/**"]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"],
			"outputs": ["dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"dependsOn": ["build"],
			"cache": false,
			"persistent": true,
			"passThroughEnv": ["*"]
		}
	},
	"globalEnv": ["CI", "NODE_ENV", "PORT", "HOST", "_VARLOCK_ENV_KEY"],
	"globalDependencies": [".env*", "apps/*/.env*", "packages/*/.env*"]
}
